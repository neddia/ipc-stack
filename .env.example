# Image pinning. Pin a real release tag before deploying a fleet — "latest"
# makes installs non-reproducible and breaks update.sh auto-rollback/pruning.
# `sudo ./update.sh <version>` pins the site-agent version and records the
# previous pin for rollback.
#
# Releases come from the Toops release mirror, reachable only over the tailnet
# (MagicDNS name `release-mirror`). It holds the GHCR credential itself, so the
# device keeps no registry login; install/update trust it as a plain-HTTP
# registry because the traffic is already inside WireGuard.
SITE_AGENT_IMAGE=release-mirror:5000/neddia/site-agent
SITE_AGENT_VERSION=latest

# Dev override (optional). When set, compose uses this env file path.
# ENV_FILE=.env.dev

# mDNS service (avahi) for UI discovery
SETPOINT_UI_PORT=8000

# Host port binding policy.
# The local UI is LAN-accessible by default. Data/control ports stay local-only.
INFLUX_BIND_HOST=127.0.0.1
INFLUX_HOST_PORT=8086
SITE_AGENT_BIND_HOST=0.0.0.0
SITE_AGENT_HOST_PORT=8000

# Host storage path (persisted across container updates)
IPC_STORAGE_DIR=/opt/site-agent/storage
IPC_SECRETS_DIR=/opt/site-agent/.secrets

# Run site-agent as a non-root user (match storage ownership)
SITE_AGENT_UID=1000
SITE_AGENT_GID=1000

# Security updates install automatically every day. Kernel fixes need a reboot,
# which pauses control for a minute or two, so automatic reboots are off unless
# a site-local time is set here. With a time, the controller reboots then only
# when an installed update requires it. Set it only once the site's drives are
# known to keep running at their last speed while the controller is offline.
# IPC_AUTO_REBOOT_TIME=03:30

# Influx (local)
INFLUX_URL=http://influxdb:8086
# For bootstrap scripts that run on the host (hits host-mapped port)
INFLUX_BOOTSTRAP_URL=http://127.0.0.1:8086
INFLUX_ORG=edge-org
INFLUX_BUCKET=edge-site
INFLUX_RETENTION=30d

# Site-agent runtime
LOG_LEVEL=INFO
SITE_CONFIG_PATH=/app/storage/site-config.yml
BUILTIN_PROFILES_DIR=/app/profiles
SITE_PROFILES_DIR=/app/storage/site-profiles
# Synced optimizer evidence and terminal billing-spool rows retained on edge.
# Pending/failed rows are never removed by these age limits.
EDGE_LEDGER_RETENTION_DAYS=120
EDGE_BILLING_TERMINAL_RETENTION_DAYS=120

# Cloud control plane
# The controller API. It is an infrastructure name, separate from the brand, so
# customer firewall allowlists never change with a rebrand.
CLOUD_BASE_URL=https://api.fieldctr.com
# Browser-facing cloud URL for links a person clicks. The API host above serves
# only controller calls, so set this whenever CLOUD_BASE_URL is the API host.
CLOUD_PUBLIC_BASE_URL=https://toopscontrols.com
CLOUD_TIMEOUT_SECONDS=3
OPTIMIZER_LICENSE_POLICY=required
# Customer switch for Toops support access (dashboard + host lockout). Leave 0
# until pull-based updates ship, so a lockout never strands a device.
SUPPORT_ACCESS_TOGGLE=0
IPC_IDENTITY_PATH=/app/storage/ipc/identity.json
# Tailnet IP (auto-detected by dev-up/install; override if needed)
# TAILSCALE_IP=100.64.0.1
# IPC public key file (auto-generated; override if needed)
# IPC_PUBLIC_KEY_FILE=/run/secrets/ipc_ed25519.pub
# IPC private key file (auto-generated; override if needed)
# IPC_PRIVATE_KEY_FILE=/run/secrets/ipc_ed25519
# Cloud license signing public key for optimizer entitlement verification
# install/prod/dev scripts seed it from: ./cloud.license.ed25519.pub
# runtime path: ${IPC_SECRETS_DIR}/cloud.license.ed25519.pub
# CLOUD_LICENSE_SIGNING_PUBLIC_KEY_FILE=/run/secrets/cloud.license.ed25519.pub
# Or paste inline instead of file:
# CLOUD_LICENSE_SIGNING_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...
# Debug (optional)
# EQUIPMENT_HY_TRACE=1

# Dev-only examples (uncomment for local dev)
# IPC_STORAGE_DIR=../setpoint/storage
# IPC_SECRETS_DIR=../ipc-secrets
