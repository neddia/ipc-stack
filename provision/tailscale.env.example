# Long-lived operator credentials used only by build-media.sh to mint a
# single-use appliance auth key. Copy this file outside the public repository
# to ~/.config/toops-e2e/tailscale.env and keep it mode 0600.

# Create this OAuth client in Tailscale with the auth_keys scope and tag:ipc.
TS_API_CLIENT_ID=
TS_API_CLIENT_SECRET=

# "-" means the OAuth client's own tailnet. Tags must be among those granted
# to the OAuth client; separate multiple tags with commas.
TS_TAILNET=-
TS_TAGS=tag:ipc
