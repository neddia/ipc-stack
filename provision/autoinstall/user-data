#cloud-config
# Ubuntu Server autoinstall for IPC appliances.
#
# Per-machine placeholders to fill before flashing (see provision/README.md):
#   - identity.hostname     : ipc-<site>
#   - identity.password     : output of `mkpasswd -m sha-512` (store the
#                             cleartext in your password manager; it is the
#                             physical-console password only)
#   - ssh.authorized-keys   : your operator public key(s)
#
# Provisioning credentials (a one-time Tailscale key and read-only GHCR token)
# are embedded by the media builder and consumed on first boot. They do not
# belong in this reusable template.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Etc/UTC

  identity:
    hostname: ipc-CHANGEME
    username: toops
    # mkpasswd -m sha-512   (from the `whois` package)
    password: "CHANGEME_SHA512_CRYPT"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "ssh-ed25519 AAAA_CHANGEME_OPERATOR_KEY toops-ops"

  storage:
    layout:
      name: direct

  packages:
    - git
    - curl
    - ca-certificates

  # Never block boot on a flaky site uplink.
  network:
    version: 2
    ethernets:
      all-ethernet:
        match:
          # Covers both predictable names (eno*/enp*/ens*) and legacy eth*.
          name: "e*"
        dhcp4: true
        optional: true

  late-commands:
    # 1) Clone the deploy repo into the installed system.
    - curtin in-target -- git clone https://github.com/neddia/ipc-stack /opt/ipc-stack

    # 2) Copy the embedded, per-device seed root-only.
    - install -m 0600 -o root -g root /cdrom/nocloud/seed.env /target/opt/ipc-stack/seed.env

    # 3) Install + enable the first-boot bring-up unit.
    - cp /target/opt/ipc-stack/provision/firstboot/ipc-firstboot.sh /target/usr/local/sbin/ipc-firstboot.sh
    - chmod 0755 /target/usr/local/sbin/ipc-firstboot.sh
    - cp /target/opt/ipc-stack/provision/firstboot/ipc-firstboot.service /target/etc/systemd/system/ipc-firstboot.service
    - curtin in-target -- systemctl enable ipc-firstboot.service
