[Unit]
Description=IPC first-boot bring-up (tailscale + stack install)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/ipc-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ipc-firstboot.sh
RemainAfterExit=yes
# Setup may wait indefinitely for an operator to approve the device on the
# tailnet; the network wait and install steps fail on their own otherwise.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
