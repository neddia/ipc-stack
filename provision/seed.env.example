# Per-device provisioning seed embedded in the installer by build-media.sh.
# Consumed once by ipc-firstboot.sh, then shredded from the installed disk.
#
# Everything here is optional; missing values fall back to interactive/manual
# behavior, but a fully populated seed gives a zero-touch install.

# Normally generated into the staged seed by build-media.sh using the private
# tailscale.env OAuth client. A manually supplied single-use key remains a
# fallback when Tailscale automation is intentionally not configured.
TS_AUTHKEY=
TS_TAGS=tag:ipc
# Tailnet hostname; defaults to the machine hostname if empty.
TS_HOSTNAME=

# GHCR pull credentials (read:packages only).
GHCR_USER=
GHCR_TOKEN=

# Pin the stack release for this install (strongly recommended over latest).
SITE_AGENT_VERSION=
GATEWAYD_VERSION=

# Optional control-plane overrides. Production normally inherits these from
# .env.example; isolated qualification environments can override them here.
CLOUD_BASE_URL=
CLOUD_PUBLIC_BASE_URL=

# Optional stable appliance identity. Leave blank to persist the installed
# host's /etc/machine-id during install.
HARDWARE_SERIAL=

# Lock SSH to Tailscale after the stack is healthy (1 = yes).
TAILSCALE_SSH_ONLY=1
